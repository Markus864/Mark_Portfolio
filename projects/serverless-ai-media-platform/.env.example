# ============================================================================
# Serverless AI Media-Generation Platform — environment configuration
# Copy to `.env` and fill in real values locally. NEVER commit real secrets.
# All values below are placeholders / names only.
# ============================================================================

# --- Application ---
APP_NAME="AI Media Platform"
APP_URL="http://localhost:3000"
APP_ENV="development"                 # development | production

# --- Persistence (serverless SQL) ---
# Accessed through a repository interface; engine is swappable.
DATABASE_URL="file:./dev.db"          # local dev; production uses a managed binding

# --- Object storage (owned artifacts) ---
# Bound as a platform resource in production; name only here.
OBJECT_STORE_BINDING="media-assets"

# --- AI provider abstraction (see docs/adr/0003) ---
# Concrete provider is selected by name; core code never imports a vendor SDK.
ENABLE_LIVE_PROVIDERS="false"         # false => deterministic fallback (no spend)
MEDIA_PROVIDER="fallback"             # e.g. provider-a | provider-b | fallback
PROVIDER_API_KEY=""                   # injected secret for the selected provider
PROMPT_MODEL=""                       # optional: prompt-shaping model identifier

# --- Auth ---
# Web app uses session-based auth; programmatic/agent access uses hashed API keys.
SESSION_SECRET=""                     # signing secret for sessions
API_KEY_PREFIX="key_"                 # public prefix for issued API keys (hash stored, not the key)

# --- Billing (payments provider + internal credit ledger) ---
PAYMENTS_SECRET_KEY=""                # server-side payments API secret
PAYMENTS_WEBHOOK_SECRET=""            # to verify inbound webhook signatures (idempotent handling)
PLAN_PRICE_ID=""                      # opaque plan/price identifier from the payments provider

# --- Pipeline tuning ---
QUEUE_MAX_RETRIES="3"                 # bounded retries before dead-lettering
STALE_JOB_TIMEOUT_MINUTES="15"        # cron reaper: fail + auto-refund jobs stuck longer than this
RATE_LIMIT_PER_MINUTE="60"            # per-caller request budget on the synchronous edge
